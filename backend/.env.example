# ===== Shark Tank — configuración del backend =====

# --- Cerebro de los Sharks ---
# 0 = LLM simulado (no gasta tokens, no necesita key)
# 1 = OpenAI real (requiere OPENAI_API_KEY)
USAR_LLM_REAL=0

# --- OpenAI ---
API_TYPE=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Simulación ---
NUM_SHARKS=5        # 1 a 5 (Luffy, Shanks, Zoro, Whitebeard, Arlong)
MAX_VUELTAS=5       # tope de vueltas en la ronda de preguntas
# SEMILLA=42        # descomenta para corridas reproducibles con el simulador

# --- Servidor API (python main.py --server) ---
BACKEND_PORT=8000

# --- Azure OpenAI (alternativa: pon API_TYPE=azure) ---
# AZURE_API_KEY=
# AZURE_ENDPOINT=https://tu-recurso.openai.azure.com/
# AZURE_DEPLOYMENT=gpt-4o-mini
# AZURE_API_VERSION=2024-02-01
